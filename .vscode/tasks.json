{
  "version": "2.0.0",
  "tasks": [{
    "label": "Compiler Blockchain + Atelier 2",
    "type": "process",
    "command": "C:/msys64/ucrt64/bin/gcc.exe",
    "args": [
      "-std=c11", "-Wall", "-Wextra", "-g3",
      "-IC:/msys64/ucrt64/include",
      "blockchain.c", "src/experiences.c", "src/menu_atelier2.c",
      "src/attaques/attaque51.c", "src/attaques/selfish.c",
      "src/attaques/withholding.c", "src/attaques/sybil.c",
      "-o", "output/blockchain.exe",
      "-LC:/msys64/ucrt64/lib", "-lcrypto"
    ],
    "options": {"cwd": "${workspaceFolder}"},
    "problemMatcher": ["$gcc"],
    "group": {"kind": "build", "isDefault": true}
  }]
}
